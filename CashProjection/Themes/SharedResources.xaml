<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CashProjection.Models">

    <!--
        Local-type resources (a converter, a DataTemplate referencing one)
        live in their own merged dictionary rather than directly in
        App.xaml — WinUI's two-pass XAML compiler can't resolve types from
        the project currently being built when they're referenced straight
        from App.xaml itself (MarkupCompilePass2 runs without a
        LocalAssembly for the in-progress project), but it works fine from
        a separate dictionary merged into Application.Resources.
    -->
    <models:BoolToVisibilityConverter x:Key="BoolToVis" />
    <models:NullableDecimalToStringConverter x:Key="NullableDecimalToString" />

    <!--
        The ONE place controlling how every list in the app (the checking
        grid, other-account transactions, Match Review's candidates,
        Find's results) shows a real bank row's vendor name vs. the bank's
        own raw description — primary line on top, secondary line below
        only when it's actually set and differs from the primary. A plain
        runtime {Binding} (not {x:Bind}) deliberately, so this one template
        works unmodified against every type that exposes PrimaryDisplayName/
        SecondaryDisplayText/HasDistinctSecondaryText, whatever its concrete
        type actually is.
    -->
    <DataTemplate x:Key="DualLineNameTemplate">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding PrimaryDisplayName}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                FontSize="11"
                Opacity="0.65"
                Text="{Binding SecondaryDisplayText}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding HasDistinctSecondaryText, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
