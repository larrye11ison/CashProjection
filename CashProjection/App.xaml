<Application
    x:Class="CashProjection.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Inherit"
                    PrimaryColor="DeepPurple"
                    SecondaryColor="Lime" />

                <!--  Control-specific themes  -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DatePicker.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Card.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ListBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ListView.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PasswordBox.xaml" />

                <ResourceDictionary Source="pack://application:,,,/CashProjection;component/Assets/AppIcon.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  caret/selection tweaks  -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource SecondaryHueMidBrush}" />
                <Setter Property="SelectionOpacity" Value="0.45" />
            </Style>
            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource SecondaryHueMidBrush}" />
                <Setter Property="SelectionOpacity" Value="0.45" />
            </Style>
            <Style TargetType="{x:Type RichTextBox}">
                <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource SecondaryHueMidBrush}" />
                <Setter Property="SelectionOpacity" Value="0.45" />
            </Style>

            <!--  restore ActionButtonStyle  -->
            <Style
                x:Key="ActionButtonStyle"
                BasedOn="{StaticResource MaterialDesignOutlinedButton}"
                TargetType="Button">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />

                <!-- Ensure good contrast for dark primary colors -->
                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueLightForegroundBrush}" />
            </Style>

            <BooleanToVisibilityConverter x:Key="SharedBoolToVis" />

            <!--
                The ONE place controlling how every list in the app (the
                checking grid, other-account transactions, Match Review's
                candidates, Find's results) shows a real bank row's vendor
                name vs. the bank's own raw description — primary line on
                top, secondary line below only when it's actually set and
                differs from the primary. Bound via SecondaryDisplayText/
                HasDistinctSecondaryText, which both ProjectionItemViewModel
                and BankTransaction expose as aliases over their own
                differently-named properties (Name/Description), so this
                template works unmodified against either type. Change
                anything about how this distinction looks — font size,
                opacity, spacing — here, once, and every list picks it up.
            -->
            <DataTemplate x:Key="DualLineNameTemplate">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PrimaryDisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.65"
                        Text="{Binding SecondaryDisplayText}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasDistinctSecondaryText, Converter={StaticResource SharedBoolToVis}}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>