<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CashProjection</RootNamespace>
    <AssemblyName>CashProjection</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
        Trims satellite resource assemblies (localized exception strings
        etc.) from every referenced NuGet package down to just en-US —
        this app has never localized into anything else. Does NOT cover
        the WindowsAppSDK's own bundled native .mui resources; see the
        RemoveNonEnglishWindowsAppSdkResources target below for those.
    -->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Going.Plaid" Version="6.68.0" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
      AddMicrosoftWindowsAppSDKPayloadFilesFromComponents (imported from
      the Microsoft.WindowsAppSDK.Base NuGet package's self-contained
      targets, triggered by WindowsAppSDKSelfContained=true above)
      unconditionally globs every locale's Microsoft.ui.xaml.dll.mui /
      Microsoft.UI.Xaml.Phone.dll.mui pair from the WindowsAppSDK's
      runtimes-framework payload into the None/CopyToOutputDirectory
      pipeline — about 90 near-empty folders, with no property exposed to
      filter them, and (confirmed empirically) too early in the publish
      pipeline to intercept by hooking AfterTargets on that target itself:
      by the time ComputeResolvedFilesToPublishList runs, SDK publish
      logic has already folded those items into its own tracking, so
      removing from @(None) there turned out to be a no-op. Trimming
      @(ResolvedFileToPublish) instead — the actual final list publish
      copies from — is what works.
  -->
  <Target Name="RemoveNonEnglishWindowsAppSdkResources" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.mui' and !$([System.String]::Copy('%(RelativePath)').StartsWith('en-us\'))" />
    </ItemGroup>
  </Target>

  <!--
      CashProjection.pri (this app's own compiled-XAML resource index —
      without it, every ms-appx:///Views/*.xaml lookup fails at runtime
      with "Cannot locate resource", crashing on the very first window
      the app tries to construct) is generated by makepri.exe via
      _GenerateProjectPriFileCore (microsoft.windows.sdk.buildtools.msix's
      MSIX/packaging-oriented PRI-gen targets), which writes it straight
      to the build output path as a side effect of running an external
      tool — it was never represented as an MSBuild item, so `dotnet
      build` has it (it's just sitting there in bin\) but `dotnet
      publish` never knew to copy it. Confirmed via a diagnostic-verbosity
      build log showing ProjectPriFullPath as the property the MSIX
      targets themselves already compute and write to.
  -->
  <Target Name="IncludeProjectPriFileInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
