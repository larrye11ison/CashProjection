<ContentDialog
    x:Class="CashProjection.Views.ChangeHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Title="Change history (newest first)"
    CloseButtonText="Close">

    <controls:DataGrid
        Width="860"
        Height="520"
        AutoGenerateColumns="False"
        CanUserSortColumns="False"
        GridLinesVisibility="Horizontal"
        HeadersVisibility="Column"
        IsReadOnly="True"
        ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
        <controls:DataGrid.Columns>
            <controls:DataGridTextColumn
                Width="170"
                Binding="{Binding LocalTimestampDisplay}"
                Header="When"
                IsReadOnly="True" />
            <controls:DataGridTextColumn
                Width="110"
                Binding="{Binding ChangeType}"
                Header="Change"
                IsReadOnly="True" />
            <controls:DataGridTextColumn
                Width="*"
                Binding="{Binding Description}"
                Header="What changed"
                IsReadOnly="True" />
            <controls:DataGridTemplateColumn
                Width="220"
                Header="Actions"
                IsReadOnly="True">
                <controls:DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Click="UndoButton_Click" Content="Undo this" Tag="{Binding}" />
                            <Button Click="RollbackButton_Click" Content="Roll back to here" Tag="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </controls:DataGridTemplateColumn.CellTemplate>
            </controls:DataGridTemplateColumn>
        </controls:DataGrid.Columns>
    </controls:DataGrid>
</ContentDialog>
