<UserControl
    x:Class="CashProjection.Views.MatchReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="820"
    Height="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource MaterialDesignIconButton}"
                ToolTip="Close">
                <materialDesign:PackIcon Kind="Close" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="Presumptive matches found between your projections and real bank transactions" />
        </DockPanel>

        <!--
            One Card per projection item (the parent), with every still-open
            candidate bank transaction for it (the children) listed beneath
            — closest in date, then amount, sorted first. Grouping this way
            means an item with several plausible candidates reads as one
            decision with options, not several disconnected cards that
            happen to repeat the same projection item.
        -->
        <materialDesign:Card Grid.Row="1" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="12" ItemsSource="{Binding MatchGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,14" Padding="16,12">
                                <StackPanel>
                                    <!--  Parent: the projection item.  -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontWeight="Bold"
                                            Text="Projected" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProjectionItem.TransactionDate, StringFormat=d}" />

                                        <!--
                                            Name on top, match pattern below —
                                            only when it's actually set and
                                            differs from the name (same rule
                                            as the bank transactions' vendor
                                            name / raw description pair).
                                        -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="{Binding ProjectionItem.Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.65"
                                                Text="{Binding ProjectionItem.MatchText}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding HasDistinctMatchPattern, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding ProjectionAmount, StringFormat=C2}"
                                            TextAlignment="Right" />
                                    </Grid>

                                    <!--
                                        Children: candidate bank transactions, each
                                        independently Accept/Reject-able, indented
                                        under the parent to read as "options for
                                        this item" rather than peers of it.
                                    -->
                                    <ItemsControl ItemsSource="{Binding Candidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="28,0,0,6"
                                                    Padding="12,8"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding BankTransaction.TxnDate, StringFormat=d}" />

                                                            <!--
                                                                Vendor-name/raw-description styling here lives
                                                                in exactly one place: DualLineNameTemplate in
                                                                App.xaml.
                                                            -->
                                                            <ContentControl
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Content="{Binding BankTransaction}"
                                                                ContentTemplate="{StaticResource DualLineNameTemplate}" />

                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Text="{Binding BankTransaction.Amount, StringFormat=C2}"
                                                                TextAlignment="Right" />
                                                        </Grid>

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding Match.Score, StringFormat='Score: {0}'}" />
                                                            <Button
                                                                Margin="0,0,4,0"
                                                                Click="AcceptButton_Click"
                                                                Content="Accept"
                                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                                Tag="{Binding}" />
                                                            <Button
                                                                Click="RejectButton_Click"
                                                                Content="Reject"
                                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                                Tag="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
