<ContentDialog
    x:Class="CashProjection.Views.MatchReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Presumptive matches found between your projections and real bank transactions"
    CloseButtonText="Close">

    <!--  See ChangeHistoryDialog.xaml's comment — MaxWidth on ContentDialog itself doesn't work; the resource key must be overridden instead.  -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer Width="820" Height="520">
        <!--
            One card per projection item (the parent), with every still-open
            candidate bank transaction for it (the children) listed beneath
            — closest in date, then amount, sorted first.
        -->
        <ItemsControl ItemsSource="{x:Bind ViewModel.MatchGroups, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,14"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <!--
                                Parent: the projection item. Compact fields
                                (label/date/amount) on top; Name and the
                                match pattern — the free-text fields, and
                                the ones most likely to run long — wrap on
                                their own full-width lines below instead of
                                being squeezed into a column and truncated.
                            -->
                            <StackPanel Margin="0,0,0,10" Spacing="2">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Projected" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProjectionDateDisplay}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Text="{Binding ProjectionAmountDisplay}" />
                                </Grid>

                                <TextBlock
                                    FontWeight="Bold"
                                    Text="{Binding ProjectionItem.Name}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.65"
                                    Text="{Binding ProjectionItem.MatchText}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasDistinctMatchPattern, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!--
                                Children: candidate bank transactions, each
                                independently Accept/Reject-able, indented
                                under the parent to read as "options for
                                this item" rather than peers of it.
                            -->
                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            A visibly distinct background
                                            (not just the same card stroke
                                            the parent uses) plus more
                                            breathing room between
                                            candidates — with several
                                            candidates per projection item,
                                            identical-looking bordered
                                            blocks with only 6px between
                                            them made it hard to tell where
                                            one candidate ended and the
                                            next began.
                                        -->
                                        <Border
                                            Margin="28,0,0,10"
                                            Padding="12,8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <StackPanel Spacing="4">
                                                <!--
                                                    Compact fields (date,
                                                    amount, score, actions)
                                                    on top; the vendor
                                                    name/description — the
                                                    free-text field — gets
                                                    its own full-width,
                                                    wrapping line below via
                                                    WrappingDualLineNameTemplate
                                                    (SharedResources.xaml)
                                                    instead of being
                                                    squeezed into a column.
                                                -->
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding BankDateDisplay}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding BankAmountDisplay}" />
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding ScoreDisplay}" />
                                                        <Button Click="AcceptButton_Click" Content="Accept" Tag="{Binding}" />
                                                        <Button Click="RejectButton_Click" Content="Reject" Tag="{Binding}" />
                                                    </StackPanel>
                                                </Grid>

                                                <ContentControl
                                                    HorizontalContentAlignment="Stretch"
                                                    Content="{Binding BankTransaction}"
                                                    ContentTemplate="{StaticResource WrappingDualLineNameTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</ContentDialog>
