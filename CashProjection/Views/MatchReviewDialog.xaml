<ContentDialog
    x:Class="CashProjection.Views.MatchReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Presumptive matches found between your projections and real bank transactions"
    CloseButtonText="Close">

    <ScrollViewer Width="780" Height="520">
        <!--
            One card per projection item (the parent), with every still-open
            candidate bank transaction for it (the children) listed beneath
            — closest in date, then amount, sorted first.
        -->
        <ItemsControl ItemsSource="{x:Bind ViewModel.MatchGroups, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,14"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <!--  Parent: the projection item.  -->
                            <Grid Margin="0,0,0,10" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="Bold" Text="Projected" />
                                <TextBlock Grid.Column="1" Text="{Binding ProjectionDateDisplay}" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Text="{Binding ProjectionItem.Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.65"
                                        Text="{Binding ProjectionItem.MatchText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding HasDistinctMatchPattern, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    Text="{Binding ProjectionAmountDisplay}" />
                            </Grid>

                            <!--
                                Children: candidate bank transactions, each
                                independently Accept/Reject-able, indented
                                under the parent to read as "options for
                                this item" rather than peers of it.
                            -->
                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="28,0,0,6"
                                            Padding="12,8"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" VerticalAlignment="Center" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding BankDateDisplay}" />

                                                    <!--  Vendor-name/raw-description styling lives in exactly one place: DualLineNameTemplate in App.xaml.  -->
                                                    <ContentControl
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Content="{Binding BankTransaction}"
                                                        ContentTemplate="{StaticResource DualLineNameTemplate}" />

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        Text="{Binding BankAmountDisplay}" />
                                                </Grid>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding ScoreDisplay}" />
                                                    <Button Click="AcceptButton_Click" Content="Accept" Tag="{Binding}" />
                                                    <Button Click="RejectButton_Click" Content="Reject" Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</ContentDialog>
