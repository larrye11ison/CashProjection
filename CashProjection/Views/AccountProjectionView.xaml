<UserControl
    x:Class="CashProjection.Views.AccountProjectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CashProjection.Models"
    xmlns:local="using:CashProjection.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <UserControl.Resources>
        <models:PeriodicityToDisplayConverter x:Key="PeriodicityToDisplayConverter" />
        <local:BalanceSeverityToBackgroundConverter x:Key="BalanceSeverityToBackground" />
        <local:BalanceSeverityToForegroundConverter x:Key="BalanceSeverityToForeground" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <controls:DataGrid
                x:Name="TransactionsGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}"
                LoadingRow="TransactionsGrid_LoadingRow"
                SelectedItem="{x:Bind ViewModel.SelectedTransaction, Mode=TwoWay}"
                SelectionMode="Single"
                UnloadingRow="TransactionsGrid_UnloadingRow">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn
                        Width="120"
                        Binding="{Binding TransactionDateDisplay}"
                        Header="Date"
                        IsReadOnly="True" />

                    <!--
                        Each possible flag gets a fixed-width slot (a Grid
                        column) rather than packing left in a StackPanel —
                        so e.g. the Link glyph always sits in the same
                        horizontal spot whether or not the Calendar glyph
                        before it is showing, instead of the icons shifting
                        around depending on which ones apply to this row.
                    -->
                    <controls:DataGridTemplateColumn
                        Width="108"
                        Header="Flags"
                        IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Glyph="&#xE787;"
                                        ToolTipService.ToolTip="Projection item — editable, not yet a real bank transaction"
                                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />

                                    <!--
                                        Segoe Fluent Icons has no literal
                                        currency/dollar glyph (checked the
                                        full icon reference), so this layers
                                        a plain "$" character with the
                                        StockDown glyph (EB0F) as a badge —
                                        reads much more clearly as "money,
                                        trending down" than a plain arrow
                                        badge did.
                                    -->
                                    <Grid
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Lowest projected balance over the next 30 days"
                                        Visibility="{Binding IsLowestNearNow, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="$" />
                                        <FontIcon
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="9"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xEB0F;" />
                                    </Grid>

                                    <FontIcon
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Glyph="&#xE71B;"
                                        ToolTipService.ToolTip="{Binding MatchTooltip}"
                                        Visibility="{Binding IsMatched, Converter={StaticResource BoolToVis}}" />

                                    <FontIcon
                                        Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="&#xE7BA;"
                                        ToolTipService.ToolTip="The matched real amount differs from the projected estimate by more than the configured threshold."
                                        Visibility="{Binding HasAmountDrift, Converter={StaticResource BoolToVis}}" />

                                    <FontIcon
                                        Grid.Column="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Opacity="0.6"
                                        Glyph="&#xE823;"
                                        ToolTipService.ToolTip="Already reflected in your bank's live balance, but not yet posted as a transaction — Plaid's balance and transaction feeds can lag each other."
                                        Visibility="{Binding IsSyntheticPendingGap, Converter={StaticResource BoolToVis}}" />

                                    <FontIcon
                                        Grid.Column="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Opacity="0.6"
                                        Glyph="&#xE712;"
                                        ToolTipService.ToolTip="There may be more history beyond this point — scrolling here loads it."
                                        Visibility="{Binding MayHaveMoreHistory, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Vendor-name/raw-description styling lives in exactly one place: DualLineNameTemplate in App.xaml.  -->
                    <controls:DataGridTemplateColumn
                        Width="*"
                        CellTemplate="{StaticResource DualLineNameTemplate}"
                        Header="Name"
                        IsReadOnly="True" />

                    <controls:DataGridTextColumn
                        Width="120"
                        Binding="{Binding DepositDisplay}"
                        Header="Deposit"
                        IsReadOnly="True">
                        <controls:DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </controls:DataGridTextColumn.ElementStyle>
                    </controls:DataGridTextColumn>

                    <controls:DataGridTextColumn
                        Width="120"
                        Binding="{Binding PaymentDisplay}"
                        Header="Payment"
                        IsReadOnly="True">
                        <controls:DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </controls:DataGridTextColumn.ElementStyle>
                    </controls:DataGridTextColumn>

                    <!--
                        Fluent 2 "warning colors" highlight just this cell
                        when the balance crosses a threshold — not the whole
                        row — so it's unambiguous that the balance itself is
                        what's being flagged.
                    -->
                    <controls:DataGridTemplateColumn
                        Width="120"
                        Header="Balance"
                        IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="12,0" Background="{Binding BalanceSeverity, Converter={StaticResource BalanceSeverityToBackground}}">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding BalanceSeverity, Converter={StaticResource BalanceSeverityToForeground}}"
                                        Text="{Binding BalanceDisplay}"
                                        ToolTipService.ToolTip="{Binding BalanceSourceDescription}" />
                                </Border>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Blank for real transactions (Periodicity.NotApplicable) instead of the raw enum name  -->
                    <controls:DataGridTemplateColumn
                        Width="140"
                        Header="Periodicity"
                        IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Periodicity, Converter={StaticResource PeriodicityToDisplayConverter}}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <!--
            Overlay, not a second row — a row that appears/disappears would
            resize the grid's own viewport and could itself trigger another
            scroll-position change right as a fetch starts.
        -->
        <Border
            Margin="0,0,0,16"
            Padding="12,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="14" Height="14" IsActive="True" />
                <TextBlock VerticalAlignment="Center" Text="Loading more…" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
