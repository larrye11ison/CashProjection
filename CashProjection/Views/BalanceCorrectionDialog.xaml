<ContentDialog
    x:Class="CashProjection.Views.BalanceCorrectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Correct Balance"
    CloseButtonClick="ContentDialog_CloseButtonClick"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Save Correction">

    <StackPanel Width="400" Spacing="16">
        <!--
            Prominent, impossible-to-miss warning — this overrides what
            Plaid reported/estimated, is treated as a verified fact going
            forward, and ripples backward through every earlier real
            transaction's displayed balance. Not undoable via Ctrl+Z.
        -->
        <Border
            Padding="12"
            Background="{ThemeResource SystemFillColorCriticalBrush}"
            CornerRadius="4">
            <!--
                A horizontal StackPanel gives its children unconstrained
                width along the stacking axis during measure, so
                TextWrapping="Wrap" had nothing to wrap against — the text
                just measured at its full, unwrapped width and got clipped
                by the border. A Grid's columns actually constrain the
                text's width (Auto for the icon, * for the text), the same
                fix used for ChangeHistoryDialog's row details.
            -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    FontSize="22"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    FontWeight="Bold"
                    Text="This overrides your bank's reported balance and is treated as a verified fact — every earlier transaction's displayed balance will be recalculated from it. This cannot be undone with Ctrl+Z. Only do this if you've confirmed the correct balance yourself (e.g. your bank's own website)."
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!--  Read-only context so it's clear which transaction this is.  -->
        <StackPanel>
            <TextBlock
                FontWeight="Bold"
                Text="{x:Bind ViewModel.TransactionName}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Margin="0,2,0,0"
                FontSize="12"
                Opacity="0.65"
                Text="{x:Bind ViewModel.TransactionDateDisplay}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBox
                x:Name="NewBalanceBox"
                Header="Correct balance"
                Text="{x:Bind ViewModel.NewBalanceText, Mode=TwoWay}" />
            <TextBlock
                FontSize="11"
                Opacity="0.65"
                Text="The account balance immediately after this transaction."
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
