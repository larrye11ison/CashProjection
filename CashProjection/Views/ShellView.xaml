<Window
    x:Class="CashProjection.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    xmlns:views="using:CashProjection.Views">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <CommandBar
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton
                Command="{x:Bind ViewModel.AddNewCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Add New"
                ToolTipService.ToolTip="Add a new projection item">
                <!--  Same Calendar glyph as the Flags column's projection-item marker — there's no CalendarAdd in this font, and AppBarButton.Icon can't layer two icons.  -->
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE787;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.EditSelectedCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Edit"
                ToolTipService.ToolTip="Edit the selected item (F2)">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Edit" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F2" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.PushForwardSelectedCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Push Forward"
                ToolTipService.ToolTip="Push the selected item forward by its periodicity">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Forward" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.CorrectBalanceSelectedCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Correct Balance"
                ToolTipService.ToolTip="Manually override the selected real transaction's balance — only when Plaid's reported/estimated balance is wrong">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Repair" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.OpenFindCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Find"
                ToolTipService.ToolTip="Find transactions (Ctrl+F)">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Find" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.UndoCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Undo"
                ToolTipService.ToolTip="Undo the most recent change (Ctrl+Z)">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Undo" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Z" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.RedoCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Redo"
                ToolTipService.ToolTip="Redo the last undone change (Ctrl+Y)">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Redo" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Y" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.OpenHistoryCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="History"
                ToolTipService.ToolTip="View change history (Ctrl+H)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="H" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.OpenMatchesCommand}"
                IsEnabled="{x:Bind ViewModel.HasSelectedAccount, Mode=OneWay}"
                Label="Matches"
                ToolTipService.ToolTip="Review presumptive matches between projections and real bank transactions (Ctrl+M)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71B;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.ReconnectBankCommand}"
                Label="Reconnect Bank"
                ToolTipService.ToolTip="Repair the existing Plaid connection in place (update mode) — never creates a new connection or uses another slot">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Sync" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.OpenPlaidSettingsCommand}"
                Label="Plaid Settings"
                ToolTipService.ToolTip="Switch between Sandbox and Production, and manage Production credentials">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Setting" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!--
            The account switcher doubles as the page title (no separate
            "Account Name" label), with the balance block sourced straight
            from ShellViewModel.SelectedAccount rather than AccountVM, since
            a sync only updates the latter in place.
        -->
        <Grid
            Grid.Row="1"
            Margin="20,16,20,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="AccountCombo"
                Grid.Column="0"
                HorizontalAlignment="Left"
                ItemsSource="{x:Bind ViewModel.Accounts}"
                SelectedItem="{x:Bind ViewModel.SelectedAccountEntry, Mode=TwoWay}"
                ToolTipService.ToolTip="Switch between linked accounts">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  New-transactions badge — cleared the moment this account is selected.  -->
                            <shapes:Ellipse
                                Grid.Column="0"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                ToolTipService.ToolTip="New transactions since you last viewed this account"
                                Visibility="{Binding HasUnseenTransactions, Converter={StaticResource BoolToVis}}" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="22"
                                FontWeight="Bold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                Text="{Binding BalanceDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="{x:Bind ViewModel.SelectedAccountBalanceLine, Mode=OneWay}"
                    TextAlignment="Right" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Opacity="0.65"
                    Text="{x:Bind ViewModel.SelectedAccountBalanceAsOfLine, Mode=OneWay}"
                    TextAlignment="Right"
                    ToolTipService.ToolTip="The real balance reported by your bank via Plaid." />
            </StackPanel>
        </Grid>

        <!--  Content: every account gets the same projection/matching-capable view.  -->
        <Grid Grid.Row="2">
            <views:AccountProjectionView x:Name="ProjectionView" />
        </Grid>

        <!--  Status bar  -->
        <Border
            Grid.Row="3"
            Padding="12,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{x:Bind ViewModel.StatusVM.CurrentMessage, Mode=OneWay}" />
                <ProgressBar
                    Grid.Column="1"
                    Width="120"
                    Height="4"
                    Margin="12,0,0,0"
                    IsIndeterminate="{x:Bind ViewModel.StatusVM.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusVM.BusyVisibility, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
