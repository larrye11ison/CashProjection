<ContentDialog
    x:Class="CashProjection.Views.FindDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Find"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="OK">

    <Grid MinWidth="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="FindTextBox"
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            KeyDown="FindTextBox_KeyDown"
            PlaceholderText="Search by name..."
            Text="{x:Bind ViewModel.FindText, Mode=OneWay}"
            TextChanged="FindTextBox_TextChanged" />

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            Height="320"
            DoubleTapped="ResultsList_DoubleTapped"
            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Item.TransactionDateDisplay}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Item.Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Text="{Binding Item.DepositDisplay}" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Text="{Binding Item.PaymentDisplay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
