<ContentDialog
    x:Class="CashProjection.Views.FindDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Find"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="OK">

    <!--  See ChangeHistoryDialog.xaml's comment — MaxWidth on ContentDialog itself doesn't work; the resource key must be overridden instead.  -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
    </ContentDialog.Resources>

    <Grid Width="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="FindTextBox"
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            KeyDown="FindTextBox_KeyDown"
            PlaceholderText="Search by name..."
            Text="{x:Bind ViewModel.FindText, Mode=OneWay}"
            TextChanged="FindTextBox_TextChanged" />

        <!--
            Column headers — same column widths as the result template
            below, so they line up. Without these there was no indication
            of which of the two right-hand amounts was a deposit and which
            was a payment.
        -->
        <Grid
            Grid.Row="1"
            Margin="4,0,4,4"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Date" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                FontWeight="SemiBold"
                Text="Deposit" />
            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Right"
                FontWeight="SemiBold"
                Text="Payment" />
        </Grid>

        <ListView
            x:Name="ResultsList"
            Grid.Row="2"
            Height="320"
            DoubleTapped="ResultsList_DoubleTapped"
            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!--
                        Date/amounts on a compact top line; the name/vendor
                        (the field you're actually searching by, and the
                        one most likely to be long) gets its own full-width
                        line below via the same wrapping template used by
                        Match Review's candidates — see
                        SharedResources.xaml's WrappingDualLineNameTemplate.
                    -->
                    <Grid Padding="4" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TransactionDateDisplay}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Text="{Binding DepositDisplay}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Text="{Binding PaymentDisplay}" />
                        </Grid>

                        <ContentControl
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            Content="{Binding NameSource}"
                            ContentTemplate="{StaticResource WrappingDualLineNameTemplate}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
