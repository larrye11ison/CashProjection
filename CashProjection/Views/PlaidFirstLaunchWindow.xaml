<Window
    x:Class="CashProjection.Views.PlaidFirstLaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ChoiceVisibility, Mode=OneWay}">
            <TextBlock FontSize="20" FontWeight="Bold" Text="Connect Cash Projection to Plaid" TextWrapping="Wrap" />
            <TextBlock
                Opacity="0.7"
                Text="If you've already connected a bank account on another machine, import that connection here instead of linking again — Plaid Link always creates a brand-new Item, and free accounts only get a limited number of Item slots. The exported file includes client credentials too, so nothing else needs setting up separately."
                TextWrapping="Wrap" />
            <Button Click="ConnectNewButton_Click" Content="Connect a new bank account…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Click="ImportButton_Click" Content="Import an existing connection…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>

        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ImportPromptVisibility, Mode=OneWay}">
            <TextBlock FontSize="20" FontWeight="Bold" Text="Import connection" TextWrapping="Wrap" />
            <TextBlock Text="Enter the passphrase used when this connection was exported, then choose the file." TextWrapping="Wrap" />
            <PasswordBox
                x:Name="PassphraseBox"
                PasswordChanged="PassphraseBox_PasswordChanged"
                PlaceholderText="Passphrase" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                FontSize="11"
                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ValidationMessageVisibility, Mode=OneWay}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CancelImportPromptCommand}" Content="Back" />
                <Button Click="ChooseFileButton_Click" Content="Choose File…" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
