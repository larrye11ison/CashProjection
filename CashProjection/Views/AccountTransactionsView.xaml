<UserControl
    x:Class="CashProjection.Views.AccountTransactionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid Margin="12">
        <controls:DataGrid
            AutoGenerateColumns="False"
            CanUserSortColumns="False"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn
                    Width="110"
                    Binding="{Binding DateDisplay}"
                    Header="Date"
                    IsReadOnly="True" />

                <!--  Vendor-name/raw-description styling lives in exactly one place: DualLineNameTemplate in App.xaml.  -->
                <controls:DataGridTemplateColumn
                    Width="*"
                    CellTemplate="{StaticResource DualLineNameTemplate}"
                    Header="Description"
                    IsReadOnly="True" />

                <controls:DataGridTextColumn
                    Width="120"
                    Binding="{Binding AmountDisplay}"
                    Header="Amount"
                    IsReadOnly="True" />

                <controls:DataGridTextColumn
                    Width="140"
                    Binding="{Binding RunningBalanceDisplay}"
                    Header="Balance"
                    IsReadOnly="True" />

                <controls:DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding Pending}"
                    Header="Pending"
                    IsReadOnly="True" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</UserControl>
