<Window
    x:Class="CashProjection.Views.PlaidEnvironmentSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Plaid Environment Settings"
    Width="520"
    Height="520"
    Background="{DynamicResource MaterialDesignPaper}"
    Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Text="Current environment" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="20"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    Text="{Binding CurrentEnvironment}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding HasStoredProductionAccessToken, StringFormat='Production access token stored: {0}'}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Text="Production credentials" />
                <TextBlock
                    Margin="0,4,0,12"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Text="From the Plaid Dashboard (Production, not Sandbox). Stored directly in Windows Credential Manager — never written to any file."
                    TextWrapping="Wrap" />

                <TextBox
                    materialDesign:HintAssist.Hint="Production client_id"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding ProductionClientId, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox
                    x:Name="SecretPasswordBox"
                    Margin="0,12,0,0"
                    materialDesign:HintAssist.Hint="Production secret (leave blank to keep the stored one)"
                    PasswordChanged="SecretPasswordBox_PasswordChanged"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                <Button
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveProductionCredentialsCommand}"
                    Content="Save Credentials"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Text="Switch environment" />
                <TextBlock
                    Margin="0,4,0,12"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    Text="Switching requires restarting the app to take effect. Flipping back to Sandbox never deletes a stored Production connection."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding SwitchToSandboxCommand}"
                        Content="Switch to Sandbox"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button
                        Command="{Binding SwitchToProductionCommand}"
                        Content="Switch to Production"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <TextBlock
            Grid.Row="3"
            VerticalAlignment="Bottom"
            FontWeight="Bold"
            Text="{Binding StatusMessage}"
            TextWrapping="Wrap" />
    </Grid>
</Window>
